# Vercel Blob read/write token used by api/join.ts to store join-form entries.
# Create a Blob store in the Vercel dashboard (or `vercel blob store add`),
# then `vercel env pull` to populate this locally. Without it, /api/join
# returns 503 and the site's join form falls back to a mailto: link.
BLOB_READ_WRITE_TOKEN=
